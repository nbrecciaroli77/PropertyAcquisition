{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "prestart": "node scripts/sync-design.mjs",
    "start": "react-scripts start",
    "prebuild": "node scripts/sync-design.mjs",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "lint": "eslint --max-warnings=0 \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "sync-design": "node scripts/sync-design.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-restricted-syntax": [
        "error",
        {
          "selector": "JSXText[value=/Book inspection/i]",
          "message": "Say 'Add reminder' \u2014 reminders never book."
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "e2e/**/*.ts",
          "playwright.config.ts"
        ],
        "rules": {
          "jest/valid-expect": "off",
          "jest/no-conditional-expect": "off",
          "testing-library/prefer-screen-queries": "off",
          "testing-library/no-node-access": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14",
    "@types/jest": "^29",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.4",
    "jest-axe": "^11.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "4.9.5"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(lucide-react)/)"
    ],
    "moduleNameMapper": {
      "^@radix-ui/primitive/is-development$": "<rootDir>/node_modules/@radix-ui/primitive/dist/internal/is-development.true.js"
    }
  }
}